# Copy to deploy/deploy.env and edit. deploy/deploy.env is gitignored.
# All values can also be overridden by exporting them in the environment before
# running deploy.sh.

# ---------------------------------------------------------------------------
# SSH / target machine
# ---------------------------------------------------------------------------
SSH_HOST="plaat-server"          # hostname or IP of the machine running Plaat
SSH_USER="username"              # username of ssh user
SSH_PORT="22"
SSH_KEY=""                        # optional path to a private key; empty = ssh default / agent

# Password-based SSH works (you'll be prompted exactly once - the script multiplexes
# one connection for the whole run). Key-based auth is smoother; set SSH_KEY or use
# `ssh-copy-id` to avoid the prompt entirely.

# Command prefix used on the target for `systemctl` calls.
#  - "sudo"        : system services in /etc/systemd/system (the deploy/systemd/*.service files)
#  - ""            : if you run the units as --user services (also set SYSTEMCTL_USER=1)
SSH_SUDO="sudo"
SYSTEMCTL_USER="0"                # 1 => use `systemctl --user` (no sudo)

# If `sudo systemctl` on the target needs a password, either:
#   a) put it here (file is gitignored), or leave empty to be prompted once per run, or
#   b) grant NOPASSWD for just systemctl on the target (recommended) - see deploy/README.md
SUDO_PASSWORD=""

# ---------------------------------------------------------------------------
# Remote filesystem layout
# ---------------------------------------------------------------------------
REMOTE_BASE="~/plaat"
REMOTE_API_DIR="${REMOTE_BASE}/api"           # must match WorkingDirectory in plaat-api.service
REMOTE_FRONTEND_DIR="${REMOTE_BASE}/frontend" # must match WorkingDirectory in plaat-frontend.service
REMOTE_BACKUP_DIR="${REMOTE_BASE}/backups"
REMOTE_STAGING="${REMOTE_BASE}/.deploy-staging"   # scratch upload area (rsync cache)

# How many previous builds to keep per app for rollback. Minimum enforced: 1.
KEEP_BACKUPS="3"

# A deploy only ever writes/removes files that are part of the published build (it
# tracks them in a .plaat-manifest). The SQLite DB, DataProtectionKeys, logs and any
# other runtime state in the app dir are never touched.
#
# These lists are an extra safety net, used only on the FIRST deploy (before a manifest
# exists) and when snapshotting the app dir for rollback: rsync --exclude patterns,
# relative to each app dir, space separated. Add anything else you keep in the app dir.
PROTECT_PATHS_API="Plaat.db Plaat.db-shm Plaat.db-wal Plaat.db-journal *.log logs"
PROTECT_PATHS_FRONTEND="DataProtectionKeys *.log logs"

# ---------------------------------------------------------------------------
# systemd unit names
# ---------------------------------------------------------------------------
API_SERVICE="plaat-api"
FRONTEND_SERVICE="plaat-frontend"

# ---------------------------------------------------------------------------
# Post-restart health checks (curl runs ON the target)
# Any HTTP response (200/302/401/404/...) counts as "up"; only a refused/timed-out
# connection counts as "down".
# ---------------------------------------------------------------------------
API_HEALTH_URL="http://127.0.0.1:5014/swagger/index.html"
FRONTEND_HEALTH_URL="http://127.0.0.1:5179/"
HEALTH_RETRIES="10"
HEALTH_DELAY="3"                  # seconds between attempts

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
PUBLISH_PROFILE="linux-x64"      # Plaat.*/Properties/PublishProfiles/<profile>.pubxml
PUBLISH_RID="linux-x64"          # path component in that profile's <PublishDir>

# ---------------------------------------------------------------------------
# appsettings drift handling
#   prompt    : show a diff and ask per file (falls back to "keep" with no TTY)
#   keep      : always keep the target's current appsettings
#   overwrite : always push this machine's appsettings
# Applies to every appsettings*.json in the publish output, including
# appsettings.Secrets.json — whose paths/passwords are machine specific, so
# "keep" is almost always what you want there.
# ---------------------------------------------------------------------------
APPSETTINGS_ON_DIFF="prompt"
