        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Plaat.Db\Plaat.Db.csproj"/>
        <ProjectReference Include="..\Plaat.Infrastructure\Plaat.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CsvHelper" Version="34.0.0" />
        <PackageReference Include="FFMpegCore" Version="6.0.0" />
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
        <PackageReference Include="TagLibSharp" Version="2.3.0"/>
    </ItemGroup>

</Project>
