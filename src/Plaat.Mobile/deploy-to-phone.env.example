# Copy to Plaat.Mobile/deploy-to-phone.env and edit. That file is gitignored.
# Used by both deploy-to-phone.sh (physical phone) and run-on-emulator.sh (emulator).
# All values can also be overridden by exporting them before running deploy-to-phone.sh.

# ---------------------------------------------------------------------------
# Android toolchain (machine-specific paths)
# ---------------------------------------------------------------------------
ANDROID_SDK="~/.local/android-toolchain/android-sdk"
JAVA_HOME="~/.local/android-toolchain/jdk-17.0.20+8"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Pin a specific device instead of auto-picking / passing it as arg 1.
# Get the serial from `adb devices`.
MOBILE_DEVICE_SERIAL=""

# Build configuration deploy-to-phone.sh installs. Release (the default) is much faster to start;
# Debug builds quicker and can be debugged. run-on-emulator.sh always uses Debug, since it seeds the
# server address through `adb run-as`, which only works on debuggable builds.
MOBILE_CONFIGURATION="Release"

# Android application id - only change if the csproj ApplicationId changes.
MOBILE_PACKAGE="com.plaat.mobile"

# ---------------------------------------------------------------------------
# Emulator runs (run-on-emulator.sh, which reads this same file)
# ---------------------------------------------------------------------------
# AVD to boot. `emulator -list-avds` shows what exists.
EMULATOR_AVD="plaat"

# Port Plaat.Api is started on (launch profile http_local binds 0.0.0.0:<port>).
BACKEND_PORT="5014"

# Address the app is pointed at. Empty = auto-detect this machine's LAN IP, which is
# what the emulator can reach. Set it to override (e.g. a backend on another host).
BACKEND_URI=""

# Where run-on-emulator.sh writes the backend/emulator logs.
MOBILE_LOG_DIR="/tmp/plaat-emulator"

# Credentials run-on-emulator.sh signs in with (the user Plaat.Api seeds on first run).
PLAAT_USERNAME="admin"
PLAAT_PASSWORD="Admin123!"
