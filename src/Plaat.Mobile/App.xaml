<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Plaat.Mobile"
             xmlns:converters="clr-namespace:Plaat.Mobile.Converters"
             x:Class="Plaat.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:EmptyStringToZeroHeightConverter x:Key="EmptyStringToZeroHeightConverter" />
            <converters:IntGreaterThanZeroConverter x:Key="IntGreaterThanZeroConverter" />
            <converters:FavoriteLabelConverter x:Key="FavoriteLabelConverter" />
            <converters:ExpandToggleLabelConverter x:Key="ExpandToggleLabelConverter" />
            <converters:SmartLabelConverter x:Key="SmartLabelConverter" />
            <converters:SupportedFormatLabelConverter x:Key="SupportedFormatLabelConverter" />
            <converters:CountToHeightConverter x:Key="CountToHeightConverter" />
            <converters:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
            <converters:ShuffleOpacityConverter x:Key="ShuffleOpacityConverter" />
            <converters:PlayPauseIconConverter x:Key="PlayPauseIconConverter" />
            <converters:RepeatIconConverter x:Key="RepeatIconConverter" />
            <converters:RepeatOpacityConverter x:Key="RepeatOpacityConverter" />
            <converters:AlbumCoverConverter x:Key="AlbumCoverConverter" />
            <converters:TrackCoverConverter x:Key="TrackCoverConverter" />
            <converters:CurrentTrackBackgroundConverter x:Key="CurrentTrackBackgroundConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
