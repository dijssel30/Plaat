<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Plaat.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AndroidSdkDirectory>~/.local/android-toolchain/android-sdk</AndroidSdkDirectory>
		<JavaSdkDirectory>~/.local/android-toolchain/jdk-17.0.20+8</JavaSdkDirectory>
		<ApplicationTitle>Plaat</ApplicationTitle>
		<ApplicationId>com.plaat.mobile</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!--
		Release is what actually runs on the phone (deploy-to-phone.sh builds it by default): Debug
		builds JIT everything and load assemblies through Fast Deployment, which makes cold start several
		times slower. Sideloaded rather than published to a store, so a plain .apk instead of the default
		.aab (which needs a bundletool round trip just to install).
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images (icons ported from Plaat.Frontend/wwwroot/icons) -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<!-- *.txt are the fonts' license texts (OFL / Apache), shipped alongside the faces as those licenses require - not fonts to register. -->
		<MauiFont Include="Resources\Fonts\*" Exclude="Resources\Fonts\*.txt" />
		<!-- ...but they do get packed into the app itself, since the OFL/Apache terms follow the
		     embedded font files into any binary we hand out. -->
		<MauiAsset Include="Resources\Fonts\*.txt" LogicalName="licenses/%(Filename)%(Extension)" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="16.0.0" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="11.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.130" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.130" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plaat.Contract\Plaat.Contract.csproj" />
	</ItemGroup>

</Project>
