<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			Android is always included. iOS/Mac Catalyst can only be restored/built on a Mac with
			Xcode installed, and Windows only on Windows, so those targets are added conditionally -
			this keeps the project genuinely multi-platform-ready without breaking `dotnet build` on
			whichever OS you're actually developing on (currently Linux, Android-only).
		-->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Plaat.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AndroidSdkDirectory>~/.local/android-toolchain/android-sdk</AndroidSdkDirectory>
		<JavaSdkDirectory>~/.local/android-toolchain/jdk-17.0.20+8</JavaSdkDirectory>

		<!-- Display name -->
		<ApplicationTitle>Plaat</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.plaat.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!--
		Release is what actually runs on the phone (deploy-to-phone.sh builds it by default): Debug
		builds JIT everything and load assemblies through Fast Deployment, which makes cold start several
		times slower. Sideloaded rather than published to a store, so a plain .apk instead of the default
		.aab (which needs a bundletool round trip just to install).
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images (icons ported from Plaat.Frontend/wwwroot/icons) -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<!-- *.txt are the fonts' license texts (OFL / Apache), shipped alongside the faces as those licenses require - not fonts to register. -->
		<MauiFont Include="Resources\Fonts\*" Exclude="Resources\Fonts\*.txt" />
		<!-- ...but they do get packed into the app itself, since the OFL/Apache terms follow the
		     embedded font files into any binary we hand out. -->
		<MauiAsset Include="Resources\Fonts\*.txt" LogicalName="licenses/%(Filename)%(Extension)" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<!-- Pinned above $(MauiVersion) (10.0.0, from the workload manifest) since CommunityToolkit.Maui 15.x requires >= 10.0.60. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.120" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plaat.Contract\Plaat.Contract.csproj" />
	</ItemGroup>

</Project>
