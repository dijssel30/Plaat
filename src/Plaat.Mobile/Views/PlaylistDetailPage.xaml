<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             xmlns:player="clr-namespace:Plaat.Mobile.Views.Player"
             xmlns:trackActions="clr-namespace:Plaat.Mobile.Views.TrackActions"
             xmlns:contract="clr-namespace:Plaat.Contract;assembly=Plaat.Contract"
             xmlns:vm="clr-namespace:Plaat.Mobile.ViewModels"
             x:Class="Plaat.Mobile.Views.PlaylistDetailPage"
             x:DataType="vm:PlaylistDetailViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="16,16,16,0" Spacing="12">
            <Label Text="{Binding Playlist.PlaylistName}" FontSize="24" FontFamily="SoraBold" />
            <HorizontalStackLayout Spacing="12">
                <Button Text="Play" Command="{Binding PlayCommand}" Style="{StaticResource PillPrimary}" />
                <Button Text="Shuffle" Command="{Binding ShuffleCommand}" Style="{StaticResource PillGhost}" />
            </HorizontalStackLayout>
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <SearchBar Placeholder="Search tracks" Text="{Binding Search}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Tracks}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="contract:TrackDto">
                    <Grid x:Name="TrackRow" Padding="16,8" ColumnDefinitions="*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTrackTapped" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Grid.Behaviors>
                            <behaviors:TouchBehavior LongPressCompleted="OnTrackLongPressed"
                                                      LongPressCommandParameter="{Binding Source={x:Reference TrackRow}, Path=BindingContext}" />
                        </Grid.Behaviors>
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="{Binding Title}" />
                            <Label Text="{Binding AllArtists}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <player:MiniPlayerBar Grid.Row="2" />

        <trackActions:TrackActionsSheet x:Name="ActionsSheet" Grid.Row="0" Grid.RowSpan="3" RemovedFromPlaylist="OnRemovedFromPlaylist" />
    </Grid>
</ContentPage>
