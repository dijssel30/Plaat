<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             xmlns:player="clr-namespace:Plaat.Mobile.Views.Player"
             xmlns:trackActions="clr-namespace:Plaat.Mobile.Views.TrackActions"
             xmlns:contract="clr-namespace:Plaat.Contract;assembly=Plaat.Contract"
             xmlns:vm="clr-namespace:Plaat.Mobile.ViewModels"
             x:Class="Plaat.Mobile.Views.TracksPage"
             x:DataType="vm:TracksViewModel"
             Title="All Tracks">

    <Grid RowDefinitions="Auto,*,Auto">
        <SearchBar Grid.Row="0" Placeholder="Search tracks" Text="{Binding Search}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Tracks}"
                        RemainingItemsThreshold="20"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="contract:TrackDto">
                    <Grid x:Name="TrackRow" Padding="16,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTrackTapped" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Grid.Behaviors>
                            <behaviors:TouchBehavior LongPressCompleted="OnTrackLongPressed"
                                                      LongPressCommandParameter="{Binding Source={x:Reference TrackRow}, Path=BindingContext}" />
                        </Grid.Behaviors>
                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label Text="{Binding Title}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding AllArtists}" FontSize="12" TextColor="{StaticResource TextMuted}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Album}" FontSize="12" TextColor="{StaticResource TextFaint}" VerticalOptions="Center" LineBreakMode="TailTruncation" MaximumWidthRequest="110" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <player:MiniPlayerBar Grid.Row="2" />

        <trackActions:TrackActionsSheet x:Name="ActionsSheet" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>
