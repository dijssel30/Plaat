<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:player="clr-namespace:Plaat.Mobile.Views.Player"
             x:Class="Plaat.Mobile.Views.OtherPage"
             Title="Other">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="0,8">

                <Grid Padding="16,16" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAllTracksTapped" />
                    </Grid.GestureRecognizers>
                    <Label Text="All Tracks" FontSize="16" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource TextFaint}" VerticalOptions="Center" />
                </Grid>

                <Grid Padding="16,16" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTapped" />
                    </Grid.GestureRecognizers>
                    <Label Text="Search" FontSize="16" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource TextFaint}" VerticalOptions="Center" />
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="16,12" />

                <Grid Padding="16,16">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutTapped" />
                    </Grid.GestureRecognizers>
                    <Label Text="Log out" FontSize="16" TextColor="{StaticResource Danger}" VerticalOptions="Center" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <player:MiniPlayerBar Grid.Row="1" />
    </Grid>
</ContentPage>
