<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:player="clr-namespace:Plaat.Mobile.Views.Player"
             xmlns:models="clr-namespace:Plaat.Contract.Models;assembly=Plaat.Contract"
             xmlns:vm="clr-namespace:Plaat.Mobile.ViewModels"
             x:Class="Plaat.Mobile.Views.PlaylistsPage"
             x:DataType="vm:PlaylistsViewModel"
             Title="Playlists">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto,*">
            <SearchBar Grid.Row="0" Placeholder="Search playlists" Text="{Binding Search}" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Playlists}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistOnlyDto">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlaylistTapped" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding PlaylistName}" FontFamily="DMSansBold" />
                                    <Label Text="📌" IsVisible="{Binding IsPinned}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding IsSmart, Converter={StaticResource SmartLabelConverter}}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding TrackCount}" TextColor="{StaticResource TextFaint}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <player:MiniPlayerBar Grid.Row="1" />
    </Grid>
</ContentPage>
