<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>CS8981</WarningsNotAsErrors>
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.*"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.*">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.*"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.*"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Plaat.Contract\Plaat.Contract.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
        <InternalsVisibleTo Include="Plaat.Api.Tests" />
    </ItemGroup>

</Project>
