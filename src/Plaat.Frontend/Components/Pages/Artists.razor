@page "/artists"
@page "/artists/favorites"

<PageTitle>@_headingLabel</PageTitle>

<h3>@_headingLabel (@FilteredArtistList.Count)</h3>

<div>
    <div class="toolbar">
        <div class="search-bar">
            <input class="search-input"
                   placeholder="Search artists..."
                   @bind="_search"
                   @bind:event="oninput"/>
        </div>

        <button type="button"
                class="favorites-toggle-button @(_favoritesOnly ? "active" : "")"
                @onclick="ToggleFavoritesOnly">
            <span class="icon icon-heart"></span> @(_favoritesOnly ? "All Artists" : "Favorites")
        </button>
    </div>

    <div class="artist-list-container">
        <Virtualize Items="FilteredArtistList">
            <div class="artist-row">
                <NavLink class="artist-link" href="@(GetHref(context.Id))">
                    <span class="artist-link-text">@context.Name</span>
                </NavLink>
            </div>
        </Virtualize>
    </div>
</div>
