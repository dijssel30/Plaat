@page "/login"
@layout EmptyLayout

<PageTitle>Login - Plaat</PageTitle>

<div class="login-container">
    <div class="login-card">
        <h1>Plaat</h1>
        <h2>Sign in</h2>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="login-error">@_errorMessage</div>
        }

        <div class="form-group">
            <label for="username">Username</label>
            <input
                @bind="_username"
                id="username"
                name="username"
                type="text"
                class="form-control"
                autocomplete="username"
                required/>
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input
                @bind="_password"
                id="password"
                name="password"
                type="password"
                class="form-control"
                autocomplete="current-password"
                required/>
        </div>
        @if (!_isLoading)
        {
            <button
                @onclick="HandleLogin"
                type="submit"
                class="btn btn-primary login-btn">Sign in
            </button>
        }
    </div>
</div>
