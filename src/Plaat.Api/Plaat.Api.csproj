<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.*" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.*" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.0" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.0" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.0" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Plaat.Biz\Plaat.Biz.csproj" />
        <ProjectReference Include="..\Plaat.Db\Plaat.Db.csproj"/>
        <ProjectReference Include="..\Plaat.Infrastructure\Plaat.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <None Update="Plaat.jpeg">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    </ItemGroup>

</Project>
