{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Swagger": {
        "Enabled": true,
        "AllowedNetworks": []
    },
    "ConnectionStrings": {
        "SqlLiteConnection": "Data Source=Plaat.db"
    },
    "PlaatOptions": {
        "ImagesStoragePath": "~/Plaat/Images/",
        "TargetReconvertedPath": "~Plaat/Unsupported_Reconvert/",
        "RateLimitSettings": {
            "Enabled": true,
            "WindowSeconds": 60,
            "LoginPermitLimit": 3,
            "RefreshPermitLimit": 30,
            "TrustedProxies": ["127.0.0.1", "::1"]
        },
        "DiscogsSettings": {
            "Enabled": true
        },
        "BackupSettings": {
            "Enabled": false,
            "TargetFolder": "",
            "Interval": "1.00:00:00",
            "StartTime": "03:00:00",
            "KeepCount": 7
        },
        "EnableBackgroundServices": false
    }
}
